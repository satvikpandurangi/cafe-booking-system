# ==============================================================================
# CAFE BOOKING & ORDERING SYSTEM - PRODUCTION ENVIRONMENT CONFIGURATION
# Vercel Serverless & Turso (libSQL) Relational Database Architecture
# Direct UPI Intent / Deep Linking (No Payment Gateway Required)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED CONFIGURATION (Mandatory for running on Vercel / Production)
# ------------------------------------------------------------------------------
# Runtime Environment: 'production' or 'development'
# Setting NODE_ENV=production unconditionally disables dev OTP mode.
NODE_ENV=production

# Turso (libSQL) Database Connection URL (e.g., libsql://your-db-name-org.turso.io)
# For local offline development fallback, leave unset or use 'file:./data/cafe.db'
TURSO_DATABASE_URL=libsql://your-cafe-database-name.turso.io

# Turso Database Authorization Token (generated via `turso db tokens create <db-name>`)
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# Cryptographic Secret for signing JWT session cookies (Customer & Admin)
# MUST be a minimum 64-character random string in production.
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace_with_a_secure_64_character_random_secret_string_in_production

# Initial Super-Administrator credentials (created during first db:seed)
ADMIN_SEED_EMAIL=admin@cafe.local
ADMIN_SEED_PASSWORD=ReplaceWithStrongPassword123!

# Cafe Merchant UPI Virtual Payment Address (VPA)
# Direct UPI deep links (upi://pay?pa=...) and dynamic QRs use this ID.
UPI_ID=artisan.cafe@okaxis

# Cafe Restaurant Display Name
CAFE_NAME=Artisan Coffee & Bistro

# Standard Restaurant Goods & Services Tax (GST) Rate in percentage (%)
TAX_RATE_PERCENT=5.0

# Trusted Frontend Domains for CORS (Comma-separated)
ALLOWED_ORIGINS=https://cafe.yourdomain.com,https://your-project.vercel.app

# ------------------------------------------------------------------------------
# 2. OPTIONAL CONFIGURATION (Required only for real SMS OTP delivery)
# ------------------------------------------------------------------------------
# SMS Gateway for production customer phone OTP delivery (e.g. 'msg91', 'twilio', 'fast2sms')
SMS_PROVIDER=msg91
SMS_API_KEY=your_production_sms_gateway_api_key_here
SMS_SENDER_ID=CAFEIN
SMS_TEMPLATE_ID=your_dlt_registered_otp_template_id_here

# ------------------------------------------------------------------------------
# 3. DEVELOPMENT-ONLY CONFIGURATION (MUST NEVER BE USED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Setting OTP_DEV_MODE=true allows bypassing SMS with OTP_DEV_CODE in development.
# The server code automatically ignores this setting when NODE_ENV=production.
OTP_DEV_MODE=false
OTP_DEV_CODE=123456
PORT=3001
CLIENT_PORT=5173
